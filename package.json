{
  "name": "tilt-tools",
  "displayName": "Tilt Tools",
  "description": "Tiltfile language support, resource tree, logs and tilt up/down from VS Code",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "publisher": "owenrumney",
  "repository": {
    "type": "git",
    "url": "https://github.com/owenrumney/tilt-vscode-ext.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "icon": "resources/icon.png",
  "keywords": [
    "tilt",
    "tiltfile",
    "starlark",
    "kubernetes",
    "docker-compose",
    "language-server"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The resource tree and logs work in an untrusted workspace. tilt.lsp.path is ignored, so a cloned repository cannot choose the language server binary.",
      "restrictedConfigurations": [
        "tilt.lsp.path"
      ]
    }
  },
  "contributes": {
    "configuration": {
      "title": "Tilt Tools",
      "properties": {
        "tilt.host": {
          "type": "string",
          "default": "localhost",
          "description": "Host of the Tilt web UI."
        },
        "tilt.port": {
          "type": "number",
          "default": 10350,
          "description": "Port of the Tilt web UI."
        },
        "tilt.token": {
          "type": "string",
          "default": "",
          "description": "Tilt session token. Leave empty to read it from ~/.tilt-dev/token."
        },
        "tilt.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Connect to Tilt when VS Code starts."
        },
        "tilt.openInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Open the Tilt UI in a Simple Browser tab. Turn off to use the system browser."
        },
        "tilt.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the Tiltfile language server for diagnostics in Tiltfiles."
        },
        "tilt.lsp.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a tiltfile-lsp binary. Leave empty to use the one bundled with the extension."
        }
      }
    },
    "languages": [
      {
        "id": "tiltfile",
        "aliases": [
          "Tiltfile",
          "tiltfile"
        ],
        "filenames": [
          "Tiltfile"
        ],
        "filenamePatterns": [
          "Tiltfile.*",
          "*.Tiltfile",
          "*.tiltfile"
        ],
        "extensions": [
          ".star",
          ".tiltfile"
        ],
        "configuration": "./resources/tiltfile-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tiltfile",
        "scopeName": "source.tiltfile.tilt-tools",
        "path": "./resources/tiltfile.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tilt",
          "title": "Tilt",
          "icon": "resources/tilt.svg"
        }
      ]
    },
    "views": {
      "tilt": [
        {
          "id": "tilt.resources",
          "name": "Resources"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tilt.resources",
        "when": "tilt.state == connecting",
        "contents": "Connecting to Tilt..."
      },
      {
        "view": "tilt.resources",
        "when": "tilt.state == connected",
        "contents": "Connected to Tilt, but it reports no resources.\n\nCheck your Tiltfile, or clear the status filter."
      },
      {
        "view": "tilt.resources",
        "when": "tilt.state != connecting && tilt.state != connected && !tilt.hasTiltfile",
        "contents": "Not connected to Tilt.\n\nNo Tiltfile in the open folders. Start Tilt with `tilt up`, then connect.\n[Connect](command:tilt.connect)"
      }
    ],
    "commands": [
      {
        "command": "tilt.up",
        "title": "Tilt: Up",
        "icon": "$(debug-start)"
      },
      {
        "command": "tilt.stop",
        "title": "Tilt: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tilt.down",
        "title": "Tilt: Down (delete deployed resources)",
        "icon": "$(trash)"
      },
      {
        "command": "tilt.connect",
        "title": "Tilt: Connect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "tilt.disconnect",
        "title": "Tilt: Disconnect"
      },
      {
        "command": "tilt.reconnect",
        "title": "Tilt: Reconnect",
        "icon": "$(refresh)"
      },
      {
        "command": "tilt.showLogs",
        "title": "Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "tilt.showTiltLogs",
        "title": "Tilt: Show Tilt Logs"
      },
      {
        "command": "tilt.trigger",
        "title": "Trigger Update",
        "icon": "$(debug-restart)"
      },
      {
        "command": "tilt.openInBrowser",
        "title": "Open in Tilt UI",
        "icon": "$(link-external)"
      },
      {
        "command": "tilt.openEndpoint",
        "title": "Open Endpoint",
        "icon": "$(globe)"
      },
      {
        "command": "tilt.filterStatus",
        "title": "Tilt: Filter by Status",
        "icon": "$(filter)"
      },
      {
        "command": "tilt.clearStatusFilter",
        "title": "Tilt: Clear Status Filter",
        "icon": "$(filter-filled)"
      },
      {
        "command": "tilt.expandAll",
        "title": "Tilt: Expand All Groups",
        "icon": "$(expand-all)"
      },
      {
        "command": "tilt.collapseAll",
        "title": "Tilt: Collapse All Groups",
        "icon": "$(collapse-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tilt.up",
          "when": "view == tilt.resources && tilt.hasTiltfile",
          "group": "navigation@-2"
        },
        {
          "command": "tilt.stop",
          "when": "view == tilt.resources && tilt.hasTiltfile",
          "group": "navigation@-1"
        },
        {
          "command": "tilt.down",
          "when": "view == tilt.resources && tilt.hasTiltfile",
          "group": "2_open"
        },
        {
          "command": "tilt.filterStatus",
          "when": "view == tilt.resources && !tilt.filtered",
          "group": "navigation@0"
        },
        {
          "command": "tilt.clearStatusFilter",
          "when": "view == tilt.resources && tilt.filtered",
          "group": "navigation@0"
        },
        {
          "command": "tilt.expandAll",
          "when": "view == tilt.resources",
          "group": "1_view"
        },
        {
          "command": "tilt.collapseAll",
          "when": "view == tilt.resources",
          "group": "1_view"
        },
        {
          "command": "tilt.reconnect",
          "when": "view == tilt.resources",
          "group": "navigation@1"
        },
        {
          "command": "tilt.openInBrowser",
          "when": "view == tilt.resources",
          "group": "2_open"
        }
      ],
      "view/item/context": [
        {
          "command": "tilt.openEndpoint",
          "when": "view == tilt.resources && viewItem == tiltResourceLinks",
          "group": "inline@0"
        },
        {
          "command": "tilt.trigger",
          "when": "view == tilt.resources && viewItem =~ /^tiltResource/",
          "group": "inline@1"
        },
        {
          "command": "tilt.showLogs",
          "when": "view == tilt.resources && viewItem =~ /^tiltResource/",
          "group": "inline@2"
        },
        {
          "command": "tilt.trigger",
          "when": "view == tilt.resources && viewItem =~ /^tiltResource/",
          "group": "1_run@1"
        },
        {
          "command": "tilt.showLogs",
          "when": "view == tilt.resources && viewItem =~ /^tiltResource/",
          "group": "1_run@2"
        },
        {
          "command": "tilt.openEndpoint",
          "when": "view == tilt.resources && viewItem == tiltResourceLinks",
          "group": "1_run@3"
        }
      ],
      "commandPalette": [
        {
          "command": "tilt.trigger",
          "when": "false"
        },
        {
          "command": "tilt.showLogs",
          "when": "false"
        },
        {
          "command": "tilt.openEndpoint",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test out/test/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.91.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.1",
    "typescript": "^5.6.0"
  }
}
