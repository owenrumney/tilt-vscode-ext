{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tiltfile",
  "scopeName": "source.tiltfile.tilt-tools",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#statement-keyword"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#tilt-builtin"
    },
    {
      "include": "#tilt-type"
    },
    {
      "include": "#starlark-builtin"
    },
    {
      "include": "#tilt-module"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "#keyword-argument"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.tiltfile",
      "begin": "#",
      "end": "$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.tiltfile"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "include": "#triple-single"
        },
        {
          "include": "#triple-double"
        },
        {
          "include": "#single"
        },
        {
          "include": "#double"
        }
      ]
    },
    "triple-double": {
      "name": "string.quoted.triple.double.tiltfile",
      "begin": "(?:r|b|rb|br)?\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#format-spec"
        }
      ]
    },
    "triple-single": {
      "name": "string.quoted.triple.single.tiltfile",
      "begin": "(?:r|b|rb|br)?'''",
      "end": "'''",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#format-spec"
        }
      ]
    },
    "double": {
      "name": "string.quoted.double.tiltfile",
      "begin": "(?:r|b|rb|br)?\"",
      "end": "\"|(?=$)",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#format-spec"
        }
      ]
    },
    "single": {
      "name": "string.quoted.single.tiltfile",
      "begin": "(?:r|b|rb|br)?'",
      "end": "'|(?=$)",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#format-spec"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.tiltfile",
      "match": "\\\\(?:x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3}|[\\\\'\"abfnrtv0]|$)"
    },
    "format-spec": {
      "comment": "Tiltfile scripts lean on the % operator, so its placeholders are marked.",
      "name": "constant.other.placeholder.tiltfile",
      "match": "%(?:\\([a-zA-Z_][a-zA-Z0-9_]*\\))?[-+ #0]*[0-9*]*(?:\\.[0-9*]+)?[diouxXeEfFgGcrsa%]"
    },
    "statement-keyword": {
      "name": "keyword.control.tiltfile",
      "match": "\\b(?:if|elif|else|for|in|while|break|continue|pass|return|def|lambda|load|and|or|not)\\b"
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.tiltfile",
          "match": "\\b(?:True|False|None)\\b"
        },
        {
          "comment": "Tilt's exported constants, and any SCREAMING_CASE name read as one.",
          "name": "constant.other.tiltfile",
          "match": "\\b(?:TRIGGER_MODE_AUTO|TRIGGER_MODE_MANUAL|[A-Z][A-Z0-9_]{2,})\\b"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.tiltfile",
          "match": "\\b[0-9]+\\.[0-9]*(?:[eE][-+]?[0-9]+)?\\b|\\b[0-9]+[eE][-+]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.tiltfile",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.integer.octal.tiltfile",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.integer.tiltfile",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-definition": {
      "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.tiltfile"
        },
        "2": {
          "name": "entity.name.function.tiltfile"
        }
      }
    },
    "tilt-builtin": {
      "comment": "Generated from 'tilt dump api-docs'. See the design doc.",
      "name": "support.function.builtin.tilt",
      "match": "\\b(?:allow_k8s_contexts|analytics_settings|blob|ci_settings|custom_build|dc_resource|decode_json|decode_yaml|decode_yaml_stream|default_registry|disable_snapshots|docker_build|docker_compose|docker_prune_settings|enable_feature|encode_json|encode_yaml|encode_yaml_stream|exec_action|exit|fail|fall_back_on|filter_yaml|helm|http_get_action|include|initial_sync|k8s_context|k8s_custom_deploy|k8s_kind|k8s_namespace|k8s_resource|k8s_yaml|kustomize|link|listdir|load|load_dynamic|local|local_resource|port_forward|probe|read_file|read_json|read_yaml|read_yaml_stream|restart_container|run|secret_settings|set_team|struct|sync|tcp_socket_action|trigger_mode|update_settings|version_settings|warn|watch_file|watch_settings|workload_to_resource_function)\\b(?=\\s*\\()"
    },
    "tilt-type": {
      "name": "support.class.tilt",
      "match": "\\b(?:Blob|ExecAction|HTTPGetAction|K8sObjectID|Link|LiveUpdateStep|PortForward|Probe|TCPSocketAction|TriggerMode)\\b"
    },
    "starlark-builtin": {
      "name": "support.function.builtin.starlark",
      "match": "\\b(?:all|any|bool|bytes|dict|dir|enumerate|float|getattr|hasattr|hash|int|len|list|max|min|print|range|repr|reversed|sorted|str|tuple|type|zip)\\b(?=\\s*\\()"
    },
    "tilt-module": {
      "match": "\\b(config|os|shlex|sys|v1alpha1)\\b(?=\\s*\\.)",
      "captures": {
        "1": {
          "name": "support.module.tilt"
        }
      }
    },
    "keyword-argument": {
      "comment": "name= inside a call, which is most of what a Tiltfile is.",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(=)(?!=)",
      "captures": {
        "1": {
          "name": "variable.parameter.tiltfile"
        },
        "2": {
          "name": "keyword.operator.assignment.tiltfile"
        }
      }
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.tiltfile"
        }
      }
    },
    "operator": {
      "name": "keyword.operator.tiltfile",
      "match": "\\*\\*|//|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|[-+*/%<>=|&^~]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.tiltfile",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.tiltfile",
          "match": ":"
        }
      ]
    },
    "assignment": {
      "match": "^([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)(?!=)",
      "captures": {
        "1": {
          "name": "variable.other.assignment.tiltfile"
        },
        "2": {
          "name": "keyword.operator.assignment.tiltfile"
        }
      },
      "comment": "Anchored to column 0. An indented name= is a keyword argument, not an assignment, and TextMate cannot see the enclosing call."
    }
  }
}
